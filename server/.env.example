# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
# Development: use Neon DB connection string
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-xxx.region.aws.neon.tech/investors_world_realty?sslmode=require
# Production: use local PostgreSQL on VPS
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/investors_world_realty
DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SMTP / Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# App URLs (used for CORS and referral links)
APP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:5173
