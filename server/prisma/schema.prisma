// Investors World Realty — Prisma Schema
// Database: PostgreSQL (Neon in dev, local VPS in production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum AssociateStatus {
  INACTIVE
  ACTIVE
  SUSPENDED
  RED
}

enum LegPosition {
  LEFT
  RIGHT
}

enum TransactionType {
  DIRECT_INCOME
  LEVEL_INCOME
  MATCHING_INCOME
  REWARD_INCOME
  FUND_TRANSFER_IN
  FUND_TRANSFER_OUT
  WITHDRAWAL
  ADMIN_CREDIT
  ADMIN_DEBIT
  PACKAGE_PURCHASE
  BOOKING_PAYMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum IncomeType {
  DIRECT
  LEVEL
  MATCHING
  REWARD
}

enum IncomeStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PropertyStatus {
  AVAILABLE
  HOLD
  BOOKED
  SOLD
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  HOLD
  EXPIRED
  FAILED
}

enum KYCType {
  PAN
  AADHAAR
  BANK
}

enum KYCStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  PAYOUT
  REGISTRATION
  PROPERTY
  ANNOUNCEMENT
  INCOME
  KYC
  BOOKING
  SYSTEM
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Associate {
  id             String          @id @default(uuid())
  userId         String          @unique // IW100001 format
  name           String
  email          String          @unique
  phone          String          @unique
  password       String // bcrypt hashed
  dateOfBirth    DateTime?
  address        String?
  city           String?
  state          String?
  pincode        String?
  panNumber      String?
  profilePhoto   String? // file path

  // Extended profile fields
  fatherHusbandName String?
  gender            String?   // Male, Female, Other
  profession        String?
  maritalStatus     String?   // Single, Married, Divorced, Widowed
  aadhaarNo         String?
  joiningType       String?   // FULL_TIME or PART_TIME

  // Nominee details
  nomineeName       String?
  nomineeRelation   String?
  nomineeDob        DateTime?

  // Bank details (inline — also captured via KYC but stored here for quick access)
  bankName          String?
  bankBranchName    String?
  bankAccountNo     String?
  bankIfscCode      String?

  sponsorId      String?
  sponsor        Associate?      @relation("Sponsorship", fields: [sponsorId], references: [id])
  sponsored      Associate[]     @relation("Sponsorship")


  status         AssociateStatus @default(INACTIVE)
  joiningDate    DateTime        @default(now())
  activationDate DateTime?

  // Account deletion
  deletionRequestedAt DateTime?
  scheduledDeletionAt DateTime?

  // Rank & Promotion
  rank           Int             @default(1) // 1=Business Associate, 2=Adviser, ..., 10=President Club
  totalAreaSold  Int             @default(0) // total gaj sold personally (for promotion tracking)

  // Preferences
  theme          String          @default("light")
  language       String          @default("en")

  // Security
  failedAttempts Int             @default(0)
  lockedUntil    DateTime?

  // Soft delete
  deletedAt      DateTime?

  // Relations
  wallet         Wallet?
  treeNode       TreeNode?
  kycDocuments   KYCDocument[]
  deviceTokens   DeviceToken[]
  notifications  Notification[]
  incomeRecords  IncomeRecord[]
  supportTickets SupportTicket[]
  bookings       Booking[]
  advancePayments AdvancePayment[]
  heldProperties Property[]      @relation("HeldProperties")

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([sponsorId])
  @@index([status])
  @@index([deletedAt])
}

model TreeNode {
  id          String      @id @default(uuid())
  associateId String      @unique
  associate   Associate   @relation(fields: [associateId], references: [id])

  parentId    String?
  parent      TreeNode?   @relation("TreeHierarchy", fields: [parentId], references: [id])
  children    TreeNode[]  @relation("TreeHierarchy")

  position    LegPosition // LEFT or RIGHT under parent
  level       Int // depth in tree (root = 0)

  leftChildId  String?    @unique
  rightChildId String?    @unique

  // Business volume tracking
  leftVolume   Decimal    @default(0)
  rightVolume  Decimal    @default(0)
  carryForward Decimal    @default(0)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([parentId])
  @@index([level])
}

model Wallet {
  id           String        @id @default(uuid())
  associateId  String        @unique
  associate    Associate     @relation(fields: [associateId], references: [id])

  balance      Decimal       @default(0)
  totalCredits Decimal       @default(0)
  totalDebits  Decimal       @default(0)

  transactions Transaction[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Transaction {
  id           String            @id @default(uuid())
  walletId     String
  wallet       Wallet            @relation(fields: [walletId], references: [id])

  type         TransactionType
  amount       Decimal
  balanceAfter Decimal
  description  String
  reference    String? // counterparty userId or system reference

  status       TransactionStatus @default(COMPLETED)

  // For admin-initiated transactions
  adminId      String?
  adminReason  String?

  createdAt    DateTime          @default(now())

  @@index([walletId])
  @@index([type])
  @@index([createdAt])
}


model IncomeRecord {
  id          String       @id @default(uuid())
  associateId String
  associate   Associate    @relation(fields: [associateId], references: [id])

  type        IncomeType
  amount      Decimal
  sourceId    String? // associate who triggered this income
  payoutId    String?
  payout      Payout?      @relation(fields: [payoutId], references: [id])

  status      IncomeStatus @default(PENDING)

  createdAt   DateTime     @default(now())

  @@index([associateId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Payout {
  id             String        @id @default(uuid())
  totalAmount    Decimal
  status         PayoutStatus  @default(PENDING)
  approvedBy     String?
  rejectedReason String?

  incomeRecords  IncomeRecord[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Property {
  id          String          @id @default(uuid())
  schemeId    String?
  scheme      Scheme?         @relation(fields: [schemeId], references: [id], onDelete: SetNull)
  name        String
  description String
  location    String
  city        String
  state       String
  area        Decimal // in sq ft
  price       Decimal
  type        String // villa, plot, apartment, etc.
  amenities   Json // array of amenity strings
  status      PropertyStatus  @default(AVAILABLE)
  isFeatured  Boolean         @default(false)
  bookingMinAmount Decimal?
  bookingMaxAmount Decimal?
  holdExpiresAt DateTime?
  heldByAssociateId String?
  heldAssociate Associate?      @relation("HeldProperties", fields: [heldByAssociateId], references: [id])

  images      PropertyImage[]
  videos      PropertyVideo[]
  inquiries   PropertyInquiry[]
  bookings    Booking[]

  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([city])
  @@index([type])
  @@index([schemeId])
  @@index([deletedAt])
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  url        String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

model PropertyVideo {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  url        String
  format     String   @default("mp4")
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

model Booking {
  id              String        @id @default(uuid())
  associateId     String
  associate       Associate     @relation(fields: [associateId], references: [id])
  propertyId      String
  property        Property      @relation(fields: [propertyId], references: [id])

  // Customer details (buyer — may differ from associate)
  customerName    String?
  customerMobile  String?
  customerAddress String?

  // Plot details
  plotNo          String?
  siteNo          String?
  plotArea        Decimal?       // in gaj/sq yards
  costPerUnit     Decimal?       // cost per gaj
  chargeOfPlot    Decimal?       // extra charges
  discount        Decimal?       @default(0)
  totalBCV        Decimal?       // total BCV of plot
  totalCost       Decimal?       // total cost of plot

  // Payment details
  amount          Decimal        // booking amount
  modeOfPayment   String?        // Cash, Cheque, Online, etc.
  chequeNo        String?
  paymentDate     DateTime?
  bankName        String?
  drawnOn         DateTime?      // cheque drawn on date

  // EMI
  emiMode         String?        // Monthly, Quarterly, etc.

  // Receipt
  receiptNo       String?        @unique
  receiptUrl      String?

  status          BookingStatus  @default(PENDING)

  // Razorpay integration
  razorpayOrderId   String?        @unique
  razorpayPaymentId String?
  razorpaySignature String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([associateId])
  @@index([propertyId])
  @@index([status])
  @@index([receiptNo])
}

model KYCDocument {
  id              String    @id @default(uuid())
  associateId     String
  associate       Associate @relation(fields: [associateId], references: [id])

  type            KYCType
  documentNumber  String
  documentUrl     String // file path
  documentUrlBack String? // file path for back side of document (optional)
  status          KYCStatus @default(PENDING)
  rejectionReason String?
  verifiedBy      String?
  verifiedAt      DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([associateId, type])
  @@index([status])
}

model DeviceToken {
  id          String    @id @default(uuid())
  associateId String
  associate   Associate @relation(fields: [associateId], references: [id])

  token       String    @unique
  platform    String // android, ios, web

  createdAt   DateTime  @default(now())

  @@index([associateId])
}

model Notification {
  id          String           @id @default(uuid())
  associateId String
  associate   Associate        @relation(fields: [associateId], references: [id])

  title       String
  message     String
  type        NotificationType
  isRead      Boolean          @default(false)
  isDeleted   Boolean          @default(false)
  data        Json? // additional payload

  createdAt   DateTime         @default(now())

  @@index([associateId, isRead])
  @@index([createdAt])
}

model SupportTicket {
  id           String        @id @default(uuid())
  ticketNumber String        @unique // auto-generated e.g. TKT-000001
  associateId  String
  associate    Associate     @relation(fields: [associateId], references: [id])

  subject      String
  status       TicketStatus  @default(OPEN)

  messages     TicketMessage[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([associateId])
  @@index([status])
}

model TicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id])

  senderId   String // associate or admin ID
  senderType String // "associate" or "admin"
  message    String

  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

model Admin {
  id        String          @id @default(uuid())
  name      String
  username  String?         // login username (optional, defaults to email)
  email     String          @unique
  phone     String          @unique
  password  String // bcrypt hashed
  roleId    String
  role      AdminRole       @relation(fields: [roleId], references: [id])

  isActive  Boolean         @default(true)

  auditLogs AdminAuditLog[]

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model AdminRole {
  id          String   @id @default(uuid())
  name        String   @unique // Super Admin, Manager, Support, Accounts
  permissions Json // array of permission strings

  admins      Admin[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id])

  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model WithdrawalRequest {
  id              String           @id @default(uuid())
  associateId     String
  amount          Decimal
  status          WithdrawalStatus @default(PENDING)
  transactionRef  String?
  processedBy     String?
  processedAt     DateTime?
  rejectionReason String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([associateId])
  @@index([status])
  @@index([createdAt])
}

model PropertyInquiry {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  associateId String
  message     String

  createdAt   DateTime @default(now())

  @@index([propertyId])
}

model ContactInquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String

  createdAt DateTime @default(now())
}

model AppVersion {
  id            String   @id @default(uuid())
  platform      String // android, ios
  minVersion    String
  latestVersion String
  storeUrl      String
  forceUpdate   Boolean  @default(false)

  updatedAt     DateTime @updatedAt
}

model BrandingAsset {
  id        String   @id @default(uuid())
  key       String   @unique // logo, splash, etc.
  url       String

  updatedAt DateTime @updatedAt
}

model MasterState {
  id   String @id @default(uuid())
  name String @unique
}

model MasterCity {
  id      String @id @default(uuid())
  name    String
  stateId String

  @@index([stateId])
}

model PropertyCategory {
  id   String @id @default(uuid())
  name String @unique
}

// ─── Property Commission Slabs ────────────────────────────────────────────────
// Commission rates based on property area (in gaj/sq yards)
// Each slab defines: area range, seller commission %, and per-level upline %

model PropertyCommissionSlab {
  id            String   @id @default(uuid())
  minArea       Int      // minimum area in gaj (inclusive)
  maxArea       Int      // maximum area in gaj (inclusive, use 999999 for unlimited)
  sellerPercent Decimal  // commission % for the selling associate
  level1Percent Decimal  // direct sponsor gets this %
  level2Percent Decimal
  level3Percent Decimal
  level4Percent Decimal
  level5Percent Decimal
  level6Percent Decimal
  level7Percent Decimal
  level8Percent Decimal
  level9Percent Decimal
  level10Percent Decimal
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([minArea, maxArea])
}

// ─── Property Sale Commission Record ──────────────────────────────────────────
// Tracks commission earned from a property sale for each beneficiary

model PropertySaleCommission {
  id            String   @id @default(uuid())
  propertyId    String
  bookingId     String
  associateId   String   // who earns this commission
  sellerAssociateId String // who sold the property
  level         Int      // 0 = seller, 1 = direct sponsor, 2-10 = upline
  percentage    Decimal
  propertyPrice Decimal
  propertyArea  Int      // area in gaj
  commissionAmount Decimal
  status        String   @default("PENDING") // PENDING, APPROVED, PAID

  createdAt     DateTime @default(now())

  @@index([propertyId])
  @@index([associateId])
  @@index([bookingId])
  @@index([status])
}

// ─── Masters Module ───────────────────────────────────────────────────────────

// Account Master — bank accounts used for receiving payments
model AccountMaster {
  id            String   @id @default(uuid())
  accountName   String
  underGroup    String   // Bank, Cash, etc.
  address       String?
  state         String?
  city          String?
  mobileNo      String?
  emailId       String?
  phoneNo       String?
  gstNo         String?
  bankAccountNo String?
  branchName    String?
  bankIfscCode  String?
  type          String   @default("Dr") // Dr or Cr

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Scheme — a real estate project/scheme (extends Property concept with more detail)
model Scheme {
  id               String   @id @default(uuid())
  schemeName       String
  state            String?
  city             String?
  address          String
  pinCode          String?
  schemeType       String?  // Residential, Commercial, etc.
  featuredScheme   Boolean  @default(false)
  googleMap        String?
  shortDescription String?
  description      String?
  isActive         Boolean  @default(true)

  images           SchemeImage[]
  plots            Plot[]
  properties       Property[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Scheme Images — up to 6 images per scheme
model SchemeImage {
  id        String   @id @default(uuid())
  schemeId  String
  scheme    Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  imageUrl  String
  slot      Int      // 1 to 6
  createdAt DateTime @default(now())

  @@index([schemeId])
}

// Plc Charge — extra charge types (Corner Plot, Do Not Flat, etc.)
model PlcCharge {
  id          String   @id @default(uuid())
  plcName     String
  chargeType  String   // Percentage or Fixed
  plcCharge   Decimal

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Plot Type (Flat/Plot/Shop Master) — types of units
model PlotType {
  id        String   @id @default(uuid())
  typeName  String   @unique

  plots     Plot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Plot — individual plot/unit within a scheme
model Plot {
  id              String   @id @default(uuid())
  schemeId        String
  scheme          Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  plotTypeId      String?
  plotType        PlotType? @relation(fields: [plotTypeId], references: [id])

  plotSizeUnit    String?  // Square Yards, Square Feet, etc.
  plotSize        Decimal  // size number
  totalCost       Decimal  // base cost (size * rate)
  plotNo          String
  plcId           String?  // FK to PlcCharge
  chargeOfPlot    Decimal  @default(0) // calculated plc charge
  totalCostOfPlot Decimal  // totalCost + chargeOfPlot
  status          String   @default("Not Used") // Not Used, Booked, Sold

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schemeId])
  @@index([status])
}

// ─── Advance Payment Ledger ───────────────────────────────────────────────────
// Tracks admin-managed advance credits/debits per associate (separate from wallet)

model AdvancePayment {
  id            String   @id @default(uuid())
  associateId   String
  associate     Associate @relation(fields: [associateId], references: [id])

  type          String   // "CREDIT" | "DEBIT"
  amount        Decimal
  balanceAfter  Decimal
  account       String?  // which bank account was used
  remark        String?
  date          DateTime @default(now())

  // Admin who performed the action
  adminId       String?

  createdAt     DateTime @default(now())

  @@index([associateId])
  @@index([createdAt])
}
